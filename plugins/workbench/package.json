{
  "name": "@banzhe/dsh-workbench",
  "version": "0.1.0",
  "description": "Workspace browsing, picker and In work region Bundle: replaces the shipped ui-workspace row with a maintained fork",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banzhe/dsh-plugins.git",
    "directory": "plugins/workbench"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-remote-access": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-product-analytics": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-context-menu": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-jobs": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-schedule": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "^0.2.2-rc.2"
  },
  "devDependencies": {
    "@banzhe/dsh-devkit": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:",
    "@deepseek-ai/dsh-api-remote-access": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
