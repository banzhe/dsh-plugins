{
  "name": "@banzhe/dsh-devcontainer",
  "version": "0.3.1",
  "description": "Run every agent command inside the repository's Linux Dev Container or a Docker Sandbox: a Docker/sbx-backed ctx.shell, a ctx.fs that delegates every file operation to a runtime-resident Node helper, a Linux prompt context, and devContainer / sbx agent-preset variants",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banzhe/dsh-plugins.git",
    "directory": "plugins/devcontainer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./shell": {
      "types": "./lib/shell.d.ts",
      "default": "./lib/shell.js"
    },
    "./fs": {
      "types": "./lib/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-bash-local": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-bash-sandbox": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-store": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs-local": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs-sandbox": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-pwsh-local": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-shell": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "devDependencies": {
    "@banzhe/dsh-devkit": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:",
    "@deepseek-ai/dsh-api-gateway": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-bash-local": "catalog:",
    "@deepseek-ai/dsh-bash-sandbox": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-fs": "catalog:",
    "@deepseek-ai/dsh-fs-local": "catalog:",
    "@deepseek-ai/dsh-fs-sandbox": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-ptc-runtime": "catalog:",
    "@deepseek-ai/dsh-pwsh-local": "catalog:",
    "@deepseek-ai/dsh-sandbox": "catalog:",
    "@deepseek-ai/dsh-sandbox-policy": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/dsh-shell": "catalog:",
    "@deepseek-ai/dsh-subprocess": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/dsh-working-directory": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
