{
  "name": "@banzhe/dsh-picker-browse",
  "version": "0.1.0",
  "description": "In-app workspace directory picker: the browser dialog forked from the shipped ui-directory-picker-browse surface, with a drive-letter row in its header",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banzhe/dsh-plugins.git",
    "directory": "plugins/picker-browse"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-alpha.2 || ^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.2 || ^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.2 || ^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.2 || ^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-alpha.2 || ^0.2.2-rc.2"
  },
  "devDependencies": {
    "@banzhe/dsh-devkit": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-workspace": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "clsx": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
