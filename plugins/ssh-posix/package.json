{
  "name": "@banzhe/dsh-ssh-posix",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSSH connection service for a Windows or POSIX host driving a POSIX remote helper: the shipped @deepseek-ai/dsh-ssh connection, forked so a Windows local host starts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banzhe/dsh-plugins.git",
    "directory": "plugins/ssh-posix"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./fs": {
      "types": "./lib/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/index.d.ts",
    "lib/fs.js",
    "lib/fs.js.map",
    "lib/fs.d.ts",
    "lib/fs.d.ts.map",
    "lib/schemas-*.js",
    "lib/schemas-*.js.map",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-brand": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.2",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-brand": "catalog:",
    "@deepseek-ai/dsh-fs": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-util-values": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
