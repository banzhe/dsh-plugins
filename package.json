{
  "name": "@banzhe/dsh-plugins",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./plugins/*\" build",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "oxlint plugins devkit",
    "lint:fix": "oxlint plugins devkit --fix",
    "prepare": "git config core.hooksPath .githooks",
    "test": "pnpm -r --filter \"./plugins/*\" --filter \"./devkit\" test",
    "typecheck": "pnpm -r --filter \"./plugins/*\" --filter \"./devkit\" typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
